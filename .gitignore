# Runtime data — the SQLite database (repo-root data/ folder). Never commit.
# (app/data/ holds the public DXCC reference table and IS committed.)
/data/
*.db
*.db-journal
*.sqlite

# Real LoTW exports, pastes and downloads must never be committed.
# Test data lives in tests/ and is synthetic.
*.adi
*.adif
/*.txt
!/requirements*.txt
/*.csv
/*.xlsx
local/

