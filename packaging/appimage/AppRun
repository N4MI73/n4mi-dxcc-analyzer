#!/bin/sh
# AppRun for the N4MI DXCC Analyzer AppImage.
# The squashfs image is read-only, so the venv and the database live outside
# it: $HOME/.local/share/n4mi-dxcc-analyzer/{venv,data}.
# Usage: N4MI-DXCC-Analyzer-*.AppImage [--port 8086] [--host 127.0.0.1] [--no-browser] [--help]
set -eu
APPDIR="$(dirname "$(readlink -f "$0")")"
APP_CODE="$APPDIR/usr/src/n4mi-dxcc-analyzer"
SHARE="${XDG_DATA_HOME:-$HOME/.local/share}/n4mi-dxcc-analyzer"
VENV="$SHARE/venv"
DATA_DIR="${DATA_DIR:-$SHARE/data}"
PORT="${PORT:-8086}"
HOST="${HOST:-127.0.0.1}"
OPEN_BROWSER=1

while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h)
      echo "N4MI DXCC Analyzer (AppImage)"
      echo "Usage: $(basename "$0") [--port 8086] [--host 127.0.0.1] [--no-browser] [--data-dir DIR]"
      echo "Env: PORT, HOST, DATA_DIR, NO_BROWSER=1"
      exit 0 ;;
    --port) PORT="${2:-8086}"; shift 2 ;;
    --host) HOST="${2:-127.0.0.1}"; shift 2 ;;
    --data-dir) DATA_DIR="$2"; shift 2 ;;
    --no-browser) OPEN_BROWSER=0; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done
if [ "${NO_BROWSER:-0}" = "1" ]; then OPEN_BROWSER=0; fi

mkdir -p "$SHARE" "$DATA_DIR"

if ! command -v python3 >/dev/null 2>&1; then
  echo "AppImage needs python3 (>= 3.11) on the host. Install it, then re-run." >&2
  exit 1
fi

if [ ! -x "$VENV/bin/uvicorn" ]; then
  echo "First run: creating venv in $VENV ..."
  python3 -m venv "$VENV"
  "$VENV/bin/pip" install --upgrade pip
  "$VENV/bin/pip" install -r "$APP_CODE/requirements.txt"
fi

export DATA_DIR
"$VENV/bin/uvicorn" app.main:create_app --factory \
  --host "$HOST" --port "$PORT" --app-dir "$APP_CODE" &
SERVER_PID=$!

cleanup() { kill "$SERVER_PID" 2>/dev/null || true; }
trap cleanup INT TERM EXIT

# Wait for /healthz (max ~20 s), then open the browser.
i=0
while [ "$i" -lt 40 ]; do
  if "$VENV/bin/python" -c "import socket; s=socket.create_connection(('$HOST' if '$HOST' != '0.0.0.0' else '127.0.0.1', $PORT), timeout=1); s.close()" 2>/dev/null; then
    break
  fi
  sleep 0.5
  i=$((i + 1))
done
URL="http://127.0.0.1:$PORT/"
echo "N4MI DXCC Analyzer running at $URL (data: $DATA_DIR)"
if [ "$OPEN_BROWSER" = "1" ]; then
  (command -v xdg-open >/dev/null 2>&1 && xdg-open "$URL" >/dev/null 2>&1) || true
fi
wait "$SERVER_PID"
